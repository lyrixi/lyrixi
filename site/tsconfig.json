{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "lyrixi-mobile": ["../lyrixi-mobile/src/index.ts"],
      "lyrixi-mobile-rn": ["../lyrixi-mobile-rn/src/index.ts"],
      "react-native": ["../node_modules/react-native-web"]
    }
  },
  "include": ["src"]
}
